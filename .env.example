# Postgres connection (Supabase or any Postgres provider). DATABASE_URL should
# point at a connection pooler (e.g. Supabase's transaction-mode pooler, port
# 6543) for use from serverless functions; DIRECT_URL is used for migrations
# and should be a direct (non-pooled) connection.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Vercel-only, do not set these for local dev ---
# SEED_SECRET gates /api/admin/seed?key=<SEED_SECRET>, a one-time endpoint
# that wipes and re-seeds the database with demo data — for deployments
# where the database is only reachable from the running app. Optional: it
# defaults to "survpay-demo-seed" if unset. Set your own if you'd rather
# the key not be a fixed, published value.
# SEED_SECRET=some-random-string

# --- "Add to Wallet" on the post-survey coupon screen ---
# Both integrations are fully implemented (real .pkpass signing, real
# Google Wallet JWT) but need the business's own developer credentials —
# SurvPay can't hold these on a business's behalf. Each button only renders
# once its own set of vars below is present; leave a set unset to hide that
# button rather than ship a broken one.
#
# Apple Wallet: from an Apple Developer account, create a Pass Type ID and
# export its certificate + private key as PEM (Keychain Access → export as
# .p12, then `openssl pkcs12 -in cert.p12 -out cert.pem -clcerts -nokeys`
# and `-nocerts -out key.pem` for the key). The WWDR cert is Apple's own
# public intermediate, downloaded once from
# https://www.apple.com/certificateauthority/ and PEM-converted the same way.
# APPLE_PASS_TYPE_ID="pass.com.yourbusiness.coupon"
# APPLE_TEAM_ID="your 10-character Apple Developer Team ID"
# APPLE_PASS_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# APPLE_PASS_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# APPLE_PASS_KEY_PASSPHRASE="only if the exported key is password-protected"
# APPLE_WWDR_CERT_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
#
# Google Wallet: from Google Cloud, enable the Wallet API, create a Wallet
# API issuer account, and create a service account with a JSON key —
# https://developers.google.com/wallet/generic/getting-started.
# GOOGLE_WALLET_ISSUER_ID="your numeric issuer ID"
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL="from the service account JSON's client_email"
# GOOGLE_WALLET_SERVICE_ACCOUNT_PRIVATE_KEY="from the service account JSON's private_key"
# GOOGLE_WALLET_CLASS_SUFFIX="survpay_coupon"  # optional, defaults to this

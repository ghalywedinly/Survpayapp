# Postgres connection (Supabase or any Postgres provider). DATABASE_URL should
# point at a connection pooler (e.g. Supabase's transaction-mode pooler, port
# 6543) for use from serverless functions; DIRECT_URL is used for migrations
# and should be a direct (non-pooled) connection.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# --- Vercel-only, do not set these for local dev ---
# AUTO_DB_PUSH=1 makes the build run `prisma db push` against DATABASE_URL
# first, so a serverless deployment can self-provision its schema. Leave
# unset locally — nobody wants `npm run build` reaching out to a database.
# AUTO_DB_PUSH=1
#
# SEED_SECRET gates /api/admin/seed?key=<SEED_SECRET>, a one-time endpoint
# that wipes and re-seeds the database with demo data — for deployments
# where the database is only reachable from the running app. Set a random
# value, visit the URL once after deploying, then you can remove it again.
# SEED_SECRET=some-random-string
